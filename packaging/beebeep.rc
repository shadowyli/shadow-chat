[BeeBEEP]
EnableSaveData=true
UseConfigurationFileIni=true
SaveDataInUserApplicationFolder=true
AllowMultipleInstances=false
BroadcastOnlyToHostsIni=false
DisableMulticast=false
UseMulticastDns=false
UseHive=false
EnableChatWithAllUsers=true
DisableFileTransfer=false
DisableFileSharing=true
DisableDesktopSharing=true
DisableVoiceMessages=true
DisableSendMessage=false
DisablePrivateChats=false
DisableEncryptedConnections=false
AllowNotEncryptedConnectionsAlso=false
AllowEncryptedConnectionsAlso=true
UseEasyConnection=false
UseCompactDataSaving=true
AllowEditNickname=true
